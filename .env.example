ENVIRONMENT=local
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/pmab.db
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
AUTO_CREATE_SCHEMA=true

JWT_SECRET=local-dev-only-change-me
JWT_EXP_MINUTES=480
HASH_ITERATIONS=200000

DEMO_ADMIN_PASSWORD=ChangeMe-Demo-Only
DEMO_ANALYST_PASSWORD=ChangeMe-Demo-Only
DEMO_VIEWER_PASSWORD=ChangeMe-Demo-Only

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/edi
S3_BUCKET=
S3_PREFIX=edi/835
S3_KMS_KEY_ID=
AWS_REGION=us-east-1

LLM_PROVIDER=mock
BEDROCK_MODEL_ID=
BEDROCK_PHI_APPROVED=false
EMBEDDING_PROVIDER=local_hash

CENTRAL_REACH_API_ENABLED=false
SFTP_ENABLED=false

RECONCILIATION_TOLERANCE=0.00
DENIAL_RATE_ALERT_THRESHOLD=0.25
PAYMENT_DELAY_THRESHOLD_DAYS=30
UNDERPAYMENT_TOLERANCE=0.01
ANOMALY_MIN_PERIODS=4
ANOMALY_MIN_CLAIMS=5
ISOLATION_FOREST_MIN_OBSERVATIONS=50
HUMAN_REVIEW_EXPOSURE_THRESHOLD=1000.00
STORED_FILENAME_PATTERN=PLUTUS_{date}_{original}_{hash}.edi
INGEST_ROOT=./sample_data
CORS_ORIGINS=http://localhost:5173
